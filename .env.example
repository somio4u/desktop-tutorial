# Vertex AI (Gemini for story + scene generation, Imagen for illustrations)
# Create a service account with the "Vertex AI User" role, download its JSON
# key, and point GOOGLE_APPLICATION_CREDENTIALS at the file. Never commit it.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_VERTEX_LLM_MODEL=gemini-2.5-flash
GOOGLE_VERTEX_IMAGE_MODEL=imagen-3.0-generate-002

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

PORT=3000
